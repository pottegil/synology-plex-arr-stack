# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# PIA username (format pXXXXXXX) and password from signup — not your email.
PIA_USER=p1234567
PIA_PASS=changeme

# Must be a port-forwarding-capable PIA region. US regions do NOT support
# port forwarding. Netherlands is a safe low-latency default for US users.
PIA_REGION=Netherlands
